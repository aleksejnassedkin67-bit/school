<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secundair Portaal - Interactief</title>
    <style>
        :root {
            --blue: #3a9ad9; --green: #2ecc71; --purple: #9b59b6; --red: #e74c3c; --gold: #f1c40f; --dark: #34495e;
        }

        body { font-family: 'Segoe UI', sans-serif; background-color: #f0f2f5; margin: 0; display: flex; justify-content: center; }

        .container {
            background: white; width: 95%; max-width: 850px; margin: 20px 0; padding: 40px 20px;
            border-radius: 60px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center; position: relative; min-height: 800px;
        }

        .page { display: none; }
        .page.active { display: block; animation: fadeIn 0.3s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        h1 { font-size: 3rem; color: var(--dark); text-transform: uppercase; font-weight: 900; margin-bottom: 25px; }
        
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; max-width: 700px; margin: 0 auto; }
        .btn { padding: 20px; border-radius: 18px; border: none; color: white; font-size: 1.3rem; font-weight: 800; cursor: pointer; text-decoration: none; display: flex; align-items: center; justify-content: center; }
        .btn-wide { grid-column: span 2; }

        /* Vakken & Keuze */
        .vak-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .vak-card { padding: 25px; border-radius: 20px; border: 1px solid #eee; font-weight: 800; cursor: pointer; background: #fff; }
        .choice-box { display: flex; flex-direction: column; gap: 20px; margin-top: 30px; }
        .big-btn { padding: 40px; border-radius: 25px; font-size: 2rem; font-weight: 900; color: white; border: none; cursor: pointer; }

        /* Planning */
        .day-nav { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
        .day-btn { padding: 12px 20px; border-radius: 12px; border: 2px solid var(--green); background: white; cursor: pointer; font-weight: 800; }
        .day-btn.active { background: var(--green); color: white; }
        .plan-list { text-align: left; background: #f9f9f9; padding: 25px; border-radius: 25px; border-left: 8px solid var(--green); }
        .plan-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #ddd; font-size: 1.2rem; }
        .pauze-text { color: var(--blue); font-weight: bold; }
        .huis-text { color: var(--red); font-weight: bold; }

        .info-card { text-align: left; background: #f9f9f9; padding: 25px; border-radius: 25px; margin-bottom: 15px; line-height: 1.6; font-size: 1.2rem; }
        .back { position: absolute; top: 25px; left: 35px; font-weight: 800; cursor: pointer; color: var(--blue); text-transform: uppercase; }

        .bg-blue { background: var(--blue); } .bg-green { background: var(--green); }
        .bg-purple { background: var(--purple); } .bg-red { background: var(--red); } .bg-gold { background: var(--gold); }
    </style>
</head>
<body>

<div class="container">
    <div id="p-home" class="page active">
        <h1>SECUNDAIR</h1>
        <div class="grid">
            <button class="btn bg-blue" onclick="go('p-vakken')">Vakken</button>
            <button class="btn bg-green" onclick="go('p-plan')">Planning</button>
            <button class="btn bg-purple" onclick="go('p-res')">Resources</button>
            <button class="btn bg-red" onclick="go('p-team-keuze')">Meneer/Mevr</button>
            <button class="btn bg-gold btn-wide" onclick="go('p-sum')">✨ Samengevat</button>
        </div>
    </div>

    <div id="p-vakken" class="page">
        <div class="back" onclick="go('p-home')">← TERUG</div>
        <h1>VAKKEN</h1>
        <div class="vak-grid">
            <div class="vak-card" onclick="startVak('STEM')">STEM</div>
            <div class="vak-card" onclick="startVak('Economie & Organisatie')">Economie & Organisatie</div>
            <div class="vak-card" onclick="startVak('Maatschappij & Welzijn')">Maatschappij & Welzijn</div>
            <div class="vak-card" onclick="startVak('Taal & Cultuur')">Taal & Cultuur</div>
            <div class="vak-card" onclick="startVak('Kunst & Creatie')">Kunst & Creatie</div>
            <div class="vak-card" onclick="startVak('Land- & Tuinbouw')">Land- & Tuinbouw</div>
            <div class="vak-card" onclick="startVak('Sport')">Sport</div>
            <div class="vak-card" onclick="startVak('Voeding & Horeca')">Voeding & Horeca</div>
        </div>
    </div>

    <div id="p-keuze" class="page">
        <div class="back" onclick="go('p-vakken')">← TERUG</div>
        <h1 id="k-titel">VAK</h1>
        <div class="choice-box">
            <button class="big-btn bg-blue" onclick="toonUitleg('Basis')">BASIS</button>
            <button class="big-btn bg-gold" onclick="toonUitleg('Uitbreiding')">UITBREIDING</button>
        </div>
    </div>

    <div id="p-uitleg" class="page">
        <div class="back" onclick="go('p-keuze')">← TERUG</div>
        <h1 id="u-titel">UITLEG</h1>
        <div class="info-card">
            <p id="u-tekst"></p>
        </div>
    </div>

    <div id="p-plan" class="page">
        <div class="back" onclick="go('p-home')">← TERUG</div>
        <h1>PLANNING</h1>
        <div class="day-nav">
            <button class="day-btn" onclick="laadDag('MA')">MA</button>
            <button class="day-btn" onclick="laadDag('DI')">DI</button>
            <button class="day-btn" onclick="laadDag('WO')">WO</button>
            <button class="day-btn" onclick="laadDag('DO')">DO</button>
            <button class="day-btn" onclick="laadDag('VR')">VR</button>
        </div>
        <div id="plan-output" class="plan-list">
            <i>Klik op een dag om het schema te zien.</i>
        </div>
    </div>

    <div id="p-team-keuze" class="page">
        <div class="back" onclick="go('p-home')">← TERUG</div>
        <h1>WIE IS WIE?</h1>
        <div class="grid">
            <button class="btn bg-blue" onclick="go('p-meneren')">DE MENEREN</button>
            <button class="btn bg-red" onclick="go('p-mevrouwen')">DE MEVROUWEN</button>
        </div>
    </div>

    <div id="p-meneren" class="page">
        <div class="back" onclick="go('p-team-keuze')">← TERUG</div>
        <h1>MENEREN</h1>
        <div class="info-card">
            • Meneer Peeters (STEM)<br>• Meneer Maes (L.O.)<br>• Meneer Jacobs (Wiskunde)<br>• Meneer Mertens (Project)<br>• Meneer Aerts (Techniek)
        </div>
    </div>

    <div id="p-mevrouwen" class="page">
        <div class="back" onclick="go('p-team-keuze')">← TERUG</div>
        <h1>MEVROUWEN</h1>
        <div class="info-card">
            • Mevrouw Janssens (Frans)<br>• Mevrouw Willems (Economie)<br>• Mevrouw Claes (M&W)<br>• Mevrouw Verbruggen (Kunst)<br>• Mevrouw De Smet (Engels)
        </div>
    </div>

    <div id="p-res" class="page"><div class="back" onclick="go('p-home')">← TERUG</div><h1>RESOURCES</h1>
        <div class="grid" style="grid-template-columns: 1fr;"><a href="https://www.smartschool.be/" target="_blank" class="btn bg-purple">Smartschool</a><a href="https://www.bingel.be/" target="_blank" class="btn bg-blue">Bingel</a><a href="https://scoodleplay.plantyn.com/" target="_blank" class="btn bg-green">Scoodle</a><a href="https://www.aanmelden.school/" target="_blank" class="btn bg-red">Aanmelden.school</a></div>
    </div>

    <div id="p-sum" class="page"><div class="back" onclick="go('p-home')">← TERUG</div><h1>SAMENGEVAT</h1><div class="info-card">Welkom op onze school! We gebruiken Smartschool voor alles. Je hebt 8 vakken en elke dag start om 08:30.</div></div>

</div>

<script>
    let gekozenVak = "";

    function go(id) {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        document.getElementById(id).classList.add('active');
        window.scrollTo(0,0);
    }

    function startVak(naam) {
        gekozenVak = naam;
        document.getElementById('k-titel').innerText = naam;
        go('p-keuze');
    }

    function toonUitleg(niveau) {
        document.getElementById('u-titel').innerText = gekozenVak + " (" + niveau + ")";
        document.getElementById('u-tekst').innerText = "Dit is de volledige uitleg over de " + niveau + " leerstof voor het vak " + gekozenVak + ". We focussen hier op de belangrijkste doelen van het leerplan.";
        go('p-uitleg');
    }

    function laadDag(dag) {
        document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
        
        let schema = `
            <div class="plan-row"><span>08:30</span> <b>🔔 Start School</b></div>
            <div class="plan-row"><span>09:20</span> Les 2</div>
            <div class="plan-row pauze-text"><span>10:10</span> ☕ Ochtendpauze</div>
            <div class="plan-row"><span>10:30</span> Les 3</div>
            <div class="plan-row"><span>11:20</span> Les 4</div>`;
        
        if (dag === 'WO') {
            schema += `<div class="plan-row huis-text"><span>12:05</span> 🏠 <b>Naar Huis</b></div>`;
        } else {
            schema += `
            <div class="plan-row pauze-text"><span>12:10</span> 🍴 Middagpauze</div>
            <div class="plan-row"><span>13:00</span> Les 5</div>
            <div class="plan-row"><span>13:50</span> Les 6</div>
            <div class="plan-row"><span>14:45</span> Les 7</div>
            <div class="plan-row huis-text"><span>15:35</span> 🏠 <b>Naar Huis</b></div>`;
        }
        document.getElementById('plan-output').innerHTML = schema;
    }
</script>

</body>
</html>
